local toggleDesync -- Declaração prévia para poder usar na função de morte

-- Função para pegar partes do corpo dinamicamente
local function getCharacterParts(char)
    local parts = {}
    if char then
        for _, part in char:GetDescendants() do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                pcall(function()
                    if part.Transparency < 1 then
                        table.insert(parts, part)
                    end
                end)
            end
        end
    end
    return parts
end

-- Função para preparar o personagem (Anti-Sit, Suporte a Morphs e Desligar ao Morrer)
local function setupCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        
        -- DESLIGA O DESYNC AUTOMATICAMENTE AO MORRER
        connections[#connections + 1] = hum.Died:Connect(function()
            if enabled and toggleDesync then
                toggleDesync()
            end
        end)
    end
    
    -- Detecta se o personagem mudou de forma/recebeu partes novas enquanto o desync tá ligado
    connections[#connections + 1] = char.DescendantAdded:Connect(function(descendant)
        if enabled and descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
            task.delay(0.05, function() -- Aguarda carregar as propriedades
                pcall(function()
                    if descendant.Transparency < 1 then
                        descendant.Transparency = 0.5
                    end
                end)
            end)
        end
    end)
end

