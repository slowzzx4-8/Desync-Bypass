-- Sistema de Arrastar UI
local dragging = false
local dragInput, dragStart, startPos

main.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

main.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input == dragInput then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- Lógica do Desync (Agora associada à variável pré-declarada)
toggleDesync = function()
    enabled = not enabled
    local bodyParts = getCharacterParts(player.Character)
    
    if enabled then
        TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = corPrincipal}):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -18, 0.5, -8)}):Play()
        for _, part in bodyParts do pcall(function() part.Transparency = 0.5 end) end
    else
        TweenService:Create(switch, TweenInfo.new(0.2), {BackgroundColor3 = corPreto}):Play()
        TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -8)}):Play()
        for _, part in bodyParts do pcall(function() part.Transparency = 0 end) end
    end
end

toggleBtn.Activated:Connect(toggleDesync)

-- Tecla Q para o Desync
connections[#connections + 1] = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.Q then
        toggleDesync()
    end
end)

-- Loop principal
connections[#connections + 1] = RunService.Heartbeat:Connect(function()
    local char = player.Character
    local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if enabled and hrp and hum then
        -- Checagem de segurança dupla de vida
        if hum.Health <= 0 then
            hum.CameraOffset = Vector3.new(0, 0, 0)
            return 
        end
        
        if hum.Sit then
            hum.Sit = false
        end
        
        local cf = hrp.CFrame
        local camOffset = hum.CameraOffset
        
        -- MUDA O EIXO PARA O LADO (X), evitando matar gigantes por atingir o limite do Void (-Y)
        local hidden = cf * CFrame.new(95000, 0, 0) 
        
        hrp.CFrame = hidden
        hum.CameraOffset = hidden:ToObjectSpace(CFrame.new(cf.Position)).Position
        
        RunService.RenderStepped:Wait()
        
        -- Somente restaura se ele continuou vivo durante a espera do frame
        if hum.Health > 0 then
            hrp.CFrame = cf
            hum.CameraOffset = camOffset
        end
    end
end)

player.CharacterAdded:Connect(function(newChar)
    setupCharacter(newChar)
    -- Ao resetar, como adicionamos a verificação de morte, o ToggleDesync será chamado automaticamente
    -- portanto, não precisamos ligar e desligar aqui para forçar.
end)

